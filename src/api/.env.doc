# ============================================
# KVCache Chatbot API - Environment Variables Configuration
# ============================================
# This file documents all available environment variables for configuration.
# Copy this file to .env and modify values as needed.
#
# Note: All environment variables are case-sensitive.
# The .env file is loaded from: src/api/.env
# ============================================

# ============================================
# API Settings (Prefix: API_)
# ============================================
# General API configuration settings

# API title displayed in documentation
API_TITLE=KVCache Chatbot API

# API version
API_VERSION=1.0.0

# API route prefix
API_PREFIX=/api/v1

# Session timeout in seconds (default: 3600 = 1 hour)
API_SESSION_TIMEOUT=3600

# ============================================
# Server Settings (Prefix: SERVER_)
# ============================================
# Server configuration for llama-server executable

# Absolute path to llama-server.exe executable
# SERVER_EXE_PATH=/absolute/path/to/llama-server.exe

# Absolute path to server log file
# SERVER_LOG_PATH=/absolute/path/to/server.log

# Cache directory path (e.g., R:\ for Windows)
# SERVER_CACHE_DIR=/path/to/cache

# ============================================
# Document Settings (Prefix: DOCUMENT_)
# ============================================
# Document management and processing settings

# Upload directory for document files (default: uploads)
DOCUMENT_UPLOAD_DIR=uploads

# Maximum file size in bytes (default: 52428800 = 50MB)
DOCUMENT_MAX_FILE_SIZE=52428800

# Allowed file extensions (list type - may need JSON format or use env.yaml)
# Note: List types may not work directly in .env, consider using env.yaml instead
# DOCUMENT_ALLOWED_EXTENSIONS=["pdf"]

# Chunking settings for PDF documents
# Maximum characters per chunk (default: 10000)
DOCUMENT_CHUNK_SIZE=10000

# Overlap between chunks for context continuity (default: 200)
DOCUMENT_CHUNK_OVERLAP=200

# Tokenizer settings
# Specify which model's tokenizer to use for token counting
# Should match a serving_name or model_name_or_path from models config
# DOCUMENT_TOKENIZER_MODEL=my-model-name

# First-stage grouping settings (token-based sequential merging)
# Enable token-based grouping when tokenizer available (default: true)
DOCUMENT_GROUPING=true

# Maximum tokens per merged group (default: 40000)
DOCUMENT_FILE_MAX_TOKENS=40000

# Minimum utilization for final group, range 0.0-1.0 (default: 0.8)
DOCUMENT_UTILIZATION_THRESHOLD=0.8

# Stage-2 similarity grouping settings
# Similarity method: "bm25" or "embedding" (default: bm25)
DOCUMENT_SIMILARITY_METHOD=bm25

# Optional BM25 threshold score (default: None)
# DOCUMENT_SIMILARITY_MIN_SCORE=0.5

# ============================================
# Prompts Settings (Prefix: PROMPTS_)
# ============================================
# Prompt template settings for RAG and document context

# System prompt template (multi-line string)
# Use \n for newlines or configure in env.yaml for better formatting
# PROMPTS_SYSTEM_PROMPT_TEMPLATE=### Task:\nRespond to the user query using the provided context.\n\n### Guidelines:\n- If you don't know the answer, clearly state that.\n- Respond in the same language as the user's query.\n\n### Output:\nProvide a clear and direct response to the user's query.\n\n<context>\n{doc_context}\n</context>

# User prompt template
# PROMPTS_USER_PROMPT_TEMPLATE=<user_query>\n{user_query}\n</user_query>
# Note: For multi-line templates, it's recommended to use env.yaml instead

# ============================================
# Model Settings (Prefix: MODEL_)
# ============================================
# Unified model configuration - supports both local and remote models
# Note: Model configuration is typically done via env.yaml for better structure
# These environment variables can override or supplement YAML configuration

# Model name or path (for local models: path to .gguf file)
# MODEL_MODEL_NAME_OR_PATH=/path/to/model.gguf

# Serving name (display name for the model, defaults to model_name_or_path if not set)
# MODEL_SERVING_NAME=my-model-name

# HuggingFace tokenizer identifier (e.g., meta-llama/Llama-3.1-8B-Instruct)
# MODEL_TOKENIZER=meta-llama/Llama-3.1-8B-Instruct

# Model type: "local" or "remote" (default: local)
# MODEL_MODEL_TYPE=local

# Provider name (only for remote models: "openai", "azure", "anthropic", "google", etc.)
# MODEL_PROVIDER=openai

# Base URL for API endpoint (for remote models or local OpenAI-compatible servers)
# MODEL_BASE_URL=http://localhost:13141/v1

# API key (required for LLM service, use "not-needed" for local models)
# MODEL_API_KEY=your-api-key-here

# ============================================
# Model Completion Parameters
# ============================================
# Note: Completion parameters are nested under ModelSettings
# They may not be directly configurable via environment variables due to nesting
# It's recommended to configure these in env.yaml under completion_params
# However, if supported, they would use MODEL_ prefix:

# Temperature for text generation (default: 0.7, range: 0.0-2.0)
# MODEL_TEMPERATURE=0.7

# Maximum tokens to generate (default: 2000)
# MODEL_MAX_TOKENS=2000

# ============================================
# Model Serving Parameters (for local models)
# ============================================
# Note: Serving parameters are nested under ModelSettings and may not be directly
# configurable via environment variables. Configure in env.yaml under serving_params
# If supported, they would use MODEL_ prefix:

# Random seed (default: 0)
# MODEL_SEED=0

# Server port (default: 13141)
# MODEL_PORT=13141

# Server host (default: 0.0.0.0)
# MODEL_HOST=0.0.0.0

# Context size (default: 16384)
# MODEL_CTX_SIZE=16384

# Main GPU device ID (default: 0)
# MODEL_MAIN_GPU=0

# Parallel processing count (default: 1)
# MODEL_PARALLEL=1

# Number of GPU layers to offload (default: 100)
# MODEL_N_GPU_LAYERS=100

# Log verbosity level (default: 9)
# MODEL_LOG_VERBOSITY=9

# SSD KV offload size in GB (default: 100)
# MODEL_SSD_KV_OFFLOAD_GB=100

# DRAM KV offload size in GB (default: 0)
# MODEL_DRAM_KV_OFFLOAD_GB=0

# ============================================
# Local Model Settings (Prefix: LOCAL_MODEL_)
# ============================================
# Note: These are typically configured via env.yaml under models.local_models
# Environment variables may be used for single model configurations

# LOCAL_MODEL_MODEL_NAME_OR_PATH=/path/to/model.gguf
# LOCAL_MODEL_SERVING_NAME=my-local-model
# LOCAL_MODEL_TOKENIZER=meta-llama/Llama-3.1-8B-Instruct
# LOCAL_MODEL_MODEL_TYPE=local

# ============================================
# Remote Model Settings (Prefix: REMOTE_MODEL_)
# ============================================
# Note: These are typically configured via env.yaml under models.remote_models
# Environment variables may be used for single model configurations

# REMOTE_MODEL_PROVIDER=openai
# REMOTE_MODEL_MODEL=gpt-4o-mini
# REMOTE_MODEL_SERVING_NAME=gpt-4o-mini
# REMOTE_MODEL_BASE_URL=https://api.openai.com/v1
# REMOTE_MODEL_API_KEY=your-api-key-here
# REMOTE_MODEL_TOKENIZER=null
# REMOTE_MODEL_MODEL_TYPE=remote

# ============================================
# Configuration Notes
# ============================================
#
# 1. Priority: Environment variables override values from env.yaml
# 2. Case Sensitivity: All environment variables are case-sensitive
# 3. List Types: Some list types (e.g., allowed_extensions) may not work
#    directly in .env files. Use env.yaml for complex configurations.
# 4. Multi-line Strings: For multi-line values (e.g., prompt templates),
#    it's recommended to use env.yaml for better readability.
# 5. Nested Settings: Some nested settings (completion_params, serving_params)
#    are best configured in env.yaml due to their complex structure.
# 6. Model Configuration: While MODEL_* variables exist, it's strongly
#    recommended to configure models in env.yaml for better organization.
#
# ============================================
# Example Usage
# ============================================
#
# To use this file:
# 1. Copy env-variables.example to .env
# 2. Uncomment and modify the variables you need
# 3. Keep other variables commented or remove them
#
# Example minimal .env:
# DOCUMENT_CHUNK_SIZE=5000
# DOCUMENT_CHUNK_OVERLAP=100
# API_SESSION_TIMEOUT=7200
#
# ============================================

